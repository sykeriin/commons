{
  "name": "commons",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && npm --prefix functions run lint",
    "test:rules": "npx -y firebase-tools emulators:exec --only firestore --project demo-commons 'node tests/firebase/rules.test.mjs'",
    "test:firebase": "npx -y firebase-tools emulators:exec --only firestore --project demo-commons 'tsx tests/firebase/integration.mts'",
    "test": "npm run test:rules && npm run test:firebase && npm run test:functions",
    "build:mobile": "vite build --mode mobile",
    "cap:sync": "npm run build:mobile && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:functions": "npx -y firebase-tools emulators:exec --only firestore --project demo-commons 'tsx functions/test/handlers.test.ts'"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor-firebase/messaging": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "playwright": "1.63.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
