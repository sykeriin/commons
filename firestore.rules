rules_version = '2';

// Commons security rules.
// These mirror src/lib/permissions.ts. The client enforces the same checks, but only these rules are authoritative.
//
// Known limits (need Cloud Functions to close, see README):
//  - Event / course capacity and waitlist ordering are enforced client-side only (rules cannot count documents).
//  - Any signed-in user can create a notification for another user (bounded in size).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity helpers ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function role() { return exists(userPath()) ? get(userPath()).data.role : 'none'; }
    function myDept() { return get(userPath()).data.get('departmentId', ''); }
    // Keep in sync with BOOTSTRAP_ADMIN_EMAIL in src/lib/config.ts. Only used to create the first admin account.
    function bootstrapAdmin() {
      return request.auth.token.email == 'durva.s170@gmail.com' && request.auth.token.email_verified == true;
    }
    function isAdmin() { return signedIn() && (bootstrapAdmin() || role() == 'admin'); }
    function isStaff() { return isAdmin() || (signedIn() && role() == 'staff'); }
    function isDeptHead() { return signedIn() && role() == 'dept_head'; }
    function isTeacher() { return signedIn() && role() in ['faculty', 'dept_head']; }

    // ---------- relationship helpers ----------
    function sectionOf(id) { return get(/databases/$(database)/documents/sections/$(id)).data; }
    function instructorOf(sectionId) { return signedIn() && sectionOf(sectionId).instructorId == uid(); }
    function assignmentInstructor(aid) {
      return sectionOf(get(/databases/$(database)/documents/assignments/$(aid)).data.sectionId).instructorId;
    }
    function memberPath(clubId) { return /databases/$(database)/documents/memberships/$(clubId + '_' + request.auth.uid); }
    function clubRole(clubId) { return exists(memberPath(clubId)) ? get(memberPath(clubId)).data.role : 'none'; }
    function clubManager(clubId) { return isAdmin() || clubRole(clubId) in ['president', 'officer', 'advisor']; }
    function eventManager(eventId) {
      let e = get(/databases/$(database)/documents/events/$(eventId)).data;
      return isStaff() || e.organizerId == uid() || (e.scope == 'club' && clubManager(e.clubId));
    }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---------- people ----------
    match /users/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        id == uid() && request.resource.data.id == id && request.resource.data.karma == 0 &&
        request.resource.data.role == 'student');
      // Users edit their own profile but can never change their role/email/karma. Only students may set a department.
      allow update: if isAdmin() || (
        id == uid() &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.karma == resource.data.karma &&
        (resource.data.role == 'student' || request.resource.data.get('departmentId', '') == resource.data.get('departmentId', '')));
      allow delete: if isAdmin();
    }

    // ---------- academic structure ----------
    match /departments/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /programs/{id}    { allow read: if signedIn(); allow write: if isAdmin(); }
    match /places/{id}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /courses/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (isDeptHead() && request.resource.data.departmentId == myDept());
      allow delete: if isAdmin() || (isDeptHead() && resource.data.departmentId == myDept());
    }
    match /sections/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (isDeptHead() &&
        get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.departmentId == myDept());
      allow delete: if isAdmin();
    }

    // ---------- enrolment, grades, attendance ----------
    match /enrollments/{id} {
      allow read: if signedIn(); // seat counts and rosters. Grades live in /grades.
      allow create: if isAdmin() || (request.resource.data.studentId == uid() && request.resource.data.status in ['enrolled', 'waitlisted']);
      allow update: if isAdmin() ||
        (resource.data.studentId == uid() && request.resource.data.studentId == uid() && request.resource.data.sectionId == resource.data.sectionId) ||
        // a dropped seat promotes the next waitlisted student
        (resource.data.status == 'waitlisted' && request.resource.data.status == 'enrolled' &&
         request.resource.data.studentId == resource.data.studentId && request.resource.data.sectionId == resource.data.sectionId);
      allow delete: if isAdmin() || resource.data.studentId == uid();
    }
    match /grades/{id} {
      allow read: if signedIn() && (resource.data.studentId == uid() || resource.data.instructorId == uid() || isAdmin());
      allow create, update: if isAdmin() || (request.resource.data.instructorId == uid() && instructorOf(request.resource.data.sectionId));
      allow delete: if isAdmin() || resource.data.instructorId == uid();
    }
    match /attendance/{id} {
      allow read: if signedIn() && (resource.data.studentId == uid() || resource.data.instructorId == uid() || isAdmin());
      allow create, update: if isAdmin() || (request.resource.data.instructorId == uid() && instructorOf(request.resource.data.sectionId));
      allow delete: if isAdmin() || resource.data.instructorId == uid();
    }
    match /assignments/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || instructorOf(request.resource.data.sectionId);
      allow delete: if isAdmin() || instructorOf(resource.data.sectionId);
    }
    match /submissions/{id} {
      allow read: if signedIn() && (resource.data.studentId == uid() || resource.data.instructorId == uid() || isAdmin());
      // Students submit work (no score). Instructors score it.
      allow create: if isAdmin() ||
        (request.resource.data.studentId == uid() && !('score' in request.resource.data) &&
         request.resource.data.instructorId == assignmentInstructor(request.resource.data.assignmentId)) ||
        (request.resource.data.instructorId == uid() && assignmentInstructor(request.resource.data.assignmentId) == uid());
      allow update: if isAdmin() || (resource.data.instructorId == uid() && request.resource.data.instructorId == uid());
    }

    // ---------- clubs ----------
    match /clubs/{id} {
      allow read: if signedIn();
      // New clubs wait for staff approval unless a staff member creates them.
      allow create: if isStaff() || (signedIn() && request.resource.data.presidentId == uid() && request.resource.data.approval == 'pending');
      allow update: if isStaff() ||
        (clubManager(id) && request.resource.data.approval == resource.data.approval) ||
        (signedIn() && changedOnly(['memberCount']));
      allow delete: if isAdmin();
    }
    match /memberships/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && id == request.resource.data.clubId + '_' + request.resource.data.personId && (
        isStaff() || clubManager(request.resource.data.clubId) ||
        (request.resource.data.personId == uid() && (
          (request.resource.data.role == 'member' &&
            getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.approval == 'approved' &&
            getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.get('joinPolicy', 'open') == 'open') ||
          (request.resource.data.role == 'president' &&
            getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.presidentId == uid()))));
      allow update: if isAdmin() || clubRole(resource.data.clubId) == 'president';
      allow delete: if isAdmin() || resource.data.personId == uid() || clubManager(resource.data.clubId);
    }
    match /joinRequests/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.resource.data.personId == uid() && request.resource.data.status == 'pending');
      allow update: if clubManager(resource.data.clubId);
    }

    // ---------- events ----------
    match /events/{id} {
      allow read: if signedIn(); // pending events are hidden in the UI, not secret
      // Campus-wide events need staff approval. Club events need a club officer.
      allow create: if isStaff() || (signedIn() && request.resource.data.organizerId == uid() &&
        (request.resource.data.scope == 'campus' ? request.resource.data.approval == 'pending' : request.resource.data.approval == 'approved') &&
        (request.resource.data.scope != 'club' || clubManager(request.resource.data.clubId)) &&
        (request.resource.data.scope != 'department' || isTeacher()));
      allow update: if isStaff() || (eventManager(id) && request.resource.data.approval == resource.data.approval);
      allow delete: if eventManager(id);
    }
    match /rsvps/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || signedIn() && request.resource.data.personId == uid() && request.resource.data.checkedIn == false &&
        request.resource.data.status in ['going', 'waitlist', 'maybe'] && id == request.resource.data.eventId + '_' + request.resource.data.personId;
      allow update: if signedIn() && (
        (resource.data.personId == uid() && request.resource.data.personId == uid() && request.resource.data.checkedIn == resource.data.checkedIn) ||
        eventManager(resource.data.eventId) ||
        // cancelling frees a seat for the next waitlisted person
        (resource.data.status == 'waitlist' && request.resource.data.status == 'going' && changedOnly(['status'])));
      allow delete: if signedIn() && (resource.data.personId == uid() || eventManager(resource.data.eventId));
    }

    // ---------- communication ----------
    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || signedIn() && request.resource.data.authorId == uid() && (
        request.resource.data.scope == 'campus' ? isStaff() :
        request.resource.data.scope == 'department' ? (isAdmin() || (isDeptHead() && myDept() == request.resource.data.scopeId)) :
        request.resource.data.scope == 'course' ? (isAdmin() || instructorOf(request.resource.data.scopeId)) :
        request.resource.data.scope == 'club' ? clubManager(request.resource.data.scopeId) : false);
      allow update, delete: if isStaff() || resource.data.authorId == uid();
    }
    match /officeHours/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isTeacher() && request.resource.data.facultyId == uid());
      allow update: if signedIn() && (resource.data.facultyId == uid() || changedOnly(['booked']));
      allow delete: if signedIn() && resource.data.facultyId == uid();
    }
    match /notices/{id} {
      allow read: if signedIn() && resource.data.personId == uid();
      allow create: if signedIn() && request.resource.data.read == false && request.resource.data.title.size() < 120 && request.resource.data.body.size() < 500;
      allow update: if signedIn() && resource.data.personId == uid() && changedOnly(['read']);
    }

    // ---------- administration ----------
    match /roleRequests/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.personId == uid());
      allow create: if isAdmin() || (signedIn() && request.resource.data.personId == uid() && request.resource.data.status == 'pending' && request.resource.data.requested in ['faculty', 'staff']);
      allow update: if isAdmin();
    }
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && role() in ['admin', 'staff', 'dept_head'] && request.resource.data.actorId == uid();
    }
  }
}
